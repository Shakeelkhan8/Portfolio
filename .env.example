# Public site URL (used for metadata, OG tags, RSS, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required for CMS admin panel)
# From Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy name also supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin account (used by pnpm db:seed — min 12 characters)
# ADMIN_EMAIL=shakeelkhan4147@gmail.com
# ADMIN_PASSWORD=change-me-to-a-strong-password

# Contact form via Resend
# RESEND_API_KEY=
# RESEND_FROM="Portfolio Contact <hello@yourdomain.com>"
# Public site email is set in Admin → Settings (prefer a custom domain).
# CONTACT_EMAIL overrides only where form submissions are delivered:
# CONTACT_EMAIL=hello@yourdomain.com
# CONTACT_IP_SALT=change-me-in-production

# GitHub API (optional — increases rate limits)
# GITHUB_TOKEN=

# Analytics — Plausible (optional, privacy-focused)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# Error monitoring — Sentry (optional)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
